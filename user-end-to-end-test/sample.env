# cf-smtp-relay
CF_API_TOKEN=xxxxxxxxxxxxxxxx
CF_ACCOUNT_ID=xxxxxxxxxxxxxxxx
SMTP_LISTEN_ADDR=:2525
SMTP_HOSTNAME=localhost

# target
EMAIL=testing@example.local
FROM_EMAIL=relay-test@example.local

# Docker test runner
E2E_DOCKER_IMAGE=cf-smtp-relay:e2e
E2E_CONTAINER_NAME=cf-smtp-relay-e2e
E2E_HIMALAYA_POLL_SECONDS=60
E2E_HIMALAYA_POLL_INTERVAL_SECONDS=5
# Optional: use an existing himalaya config file instead of generating a temporary one.
# Example: E2E_HIMALAYA_CONFIG_PATH=/home/you/.config/himalaya/config.toml
E2E_HIMALAYA_CONFIG_PATH=

# mail account
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=

# Himalaya / IMAP check (used by run-e2e.sh)
IMAP_HOST=imap.example.local
IMAP_PORT=993
IMAP_USER=user@example.local
IMAP_PASS=pass
IMAP_MAILBOX_INBOX=INBOX
